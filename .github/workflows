name: Build HeavyWeaponSprint ASIs

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x86

      - name: Compile HeavyWeaponSprintIII
        shell: pwsh
        run: |
          $src = Get-ChildItem -Recurse -Filter HeavyWeaponSprintIII.cpp | Select-Object -First 1
          if (-not $src) { throw "HeavyWeaponSprintIII.cpp not found" }
          Push-Location $src.DirectoryName
          cl /nologo /LD /O2 /MT /EHsc /D_CRT_SECURE_NO_WARNINGS HeavyWeaponSprintIII.cpp /Fe:HeavyWeaponSprintIII.asi /link user32.lib kernel32.lib
          if ($LASTEXITCODE -ne 0) { throw "Build failed: HeavyWeaponSprintIII" }
          Pop-Location

      - name: Compile HeavyWeaponSprintVC
        shell: pwsh
        run: |
          $src = Get-ChildItem -Recurse -Filter HeavyWeaponSprintVC.cpp | Select-Object -First 1
          if (-not $src) { throw "HeavyWeaponSprintVC.cpp not found" }
          Push-Location $src.DirectoryName
          cl /nologo /LD /O2 /MT /EHsc /D_CRT_SECURE_NO_WARNINGS HeavyWeaponSprintVC.cpp /Fe:HeavyWeaponSprintVC.asi /link user32.lib kernel32.lib
          if ($LASTEXITCODE -ne 0) { throw "Build failed: HeavyWeaponSprintVC" }
          Pop-Location

      - uses: actions/upload-artifact@v4
        with:
          name: HeavyWeaponSprint
          path: |
            **/HeavyWeaponSprintIII.asi
            **/HeavyWeaponSprintVC.asi
